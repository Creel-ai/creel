#!/usr/bin/env bash
# Run ruff on staged Python files before committing

STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')

if [ -z "$STAGED_PY_FILES" ]; then
    exit 0
fi

echo "Running ruff check..."
ruff check $STAGED_PY_FILES || exit 1

echo "Running ruff format check..."
ruff format --check $STAGED_PY_FILES || { echo "Run 'ruff format' to fix formatting."; exit 1; }
